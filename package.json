{
  "name": "@emmettito/overlay-scrollbar",
  "version": "0.0.0",
  "private": true,
  "description": "Overlay scrollbars for any scrollable element, in plain TypeScript with no dependencies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmettito/overlay-scrollbar.git"
  },
  "keywords": [
    "scrollbar",
    "overlay scrollbar",
    "macos",
    "scroll"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./overlay-scrollbar.css": "./lib/overlay-scrollbar.css",
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "husky",
    "build:lib": "node scripts/build-lib.mts",
    "prepack": "node scripts/refuse-root-pack.mts",
    "package": "node scripts/pack.mts",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.spec.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "test:package": "node scripts/test-package.mts"
  },
  "packageManager": "npm@12.2.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
