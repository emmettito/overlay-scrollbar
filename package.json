{
  "name": "@emmettito/overlay-scrollbar",
  "version": "0.0.0",
  "private": true,
  "description": "Overlay scrollbars for any scrollable element, in plain TypeScript with no dependencies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmettito/overlay-scrollbar.git"
  },
  "keywords": [
    "scrollbar",
    "overlay scrollbar",
    "macos",
    "scroll"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "npm@12.2.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
