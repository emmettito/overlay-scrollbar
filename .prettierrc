{
  "arrowParens": "avoid",
  "plugins": ["prettier-plugin-organize-imports"],
  "printWidth": 120,
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false,
  "overrides": [
    {
      "files": "src/demos/**/*.ts",
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
