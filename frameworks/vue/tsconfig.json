{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "preserve",
    "paths": {
      "@emmettito/overlay-scrollbar": ["../../src/overlay-scrollbar/index.ts"],
      "@emmettito/overlay-scrollbar/*": ["../../src/overlay-scrollbar/*"]
    }
  },
  "include": ["src"]
}
